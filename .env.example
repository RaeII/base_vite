# URL do backend para onde o dev server proxia /api (vite.config.ts).
# Em produção quem proxia é o nginx/traefik — esta var só vale em dev.
VITE_API_URL=http://localhost:3000

# Client ID público do Google OAuth (login com Google). Mesmo valor de GOOGLE_CLIENT_ID no backend.
# Vazio = botão "Continuar com Google" não aparece. Cadastre a origem do front
# (ex.: http://localhost:5173) em "Origens JavaScript autorizadas" no Google Console.
# Valor abaixo = client do projeto cidoa; troque pelo do seu projeto.
VITE_GOOGLE_CLIENT_ID=234751630839-1cclfe773dck1v00tmknubila9e8tbq4.apps.googleusercontent.com
